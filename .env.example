# Copy this file to `.env` and fill sensible values for local development.
# Keep this out of version control (add .env to .gitignore in local repos).

# Secret key used to sign tokens. Use a long, random value in production.
SECRET_KEY=changeme_local_secret_key

# Toggle dev features (true/false)
DEV_MODE=true

# Database connection used by the backend service. For docker compose local usage the default
# service name `db` is used in the backend compose file.
DATABASE_URL=postgresql+psycopg2://mh_user:mh_pass@db:5432/mh_db

# Optional: Redis URL if using rate-limiter/worker with Redis
# REDIS_URL=redis://redis:6379/0

# Optional: enable background worker/scheduler
# ENABLE_BACKGROUND_WORKER=false

# Optional: for email OTP in production set a real email provider or SMTP creds.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# ============================
# MANAGED DATABASE OPTIONS
# ============================
# Instead of local Docker PostgreSQL, you can use a managed service.
# Uncomment and replace DATABASE_URL above with one of these:

# Supabase (Free 500MB, pauses after 7 days inactivity)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.projectref.supabase.co:5432/postgres

# Railway (Free $5 credits/month)
# DATABASE_URL=postgresql://postgres:password@containers.railway.app:PORT/railway

# Neon (Free 3GB, serverless, always-on)
# DATABASE_URL=postgresql://user:password@ep-name.region.neon.tech/dbname
